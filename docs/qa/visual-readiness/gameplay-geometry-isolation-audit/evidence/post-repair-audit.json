olute; left: calc(50% - 4px); top: 48%; width: 8px; height: 62%; background: #70411f; }.beach-obstacle.umbrella::after { content: \"\"; position: absolute; left: calc(50% - 5px); top: calc(50% - 5px); width: 10px; height: 10px; border: 2px solid #4b2a18; border-radius: 50%; background: #f4ead4; }.beach-obstacle.chair { width: 67%; height: 82%; aspect-ratio: auto; border: 4px solid #633c21; border-top-width: 7px; border-bottom-width: 7px; background: repeating-linear-gradient(90deg, #f7f1df 0 8px, #3979b6 8px 16px); box-shadow: inset 0 0 0 3px #d6a354; transform: perspective(60px) rotateX(-10deg); }.beach-player-icon { position: relative; z-index: 5; display: block; width: min(72%, 58px); aspect-ratio: .78; filter: drop-shadow(3px 4px 0 rgb(73 43 19 / 38%)); }.beach-player-icon::before { content: \"\"; position: absolute; left: 18%; right: 18%; bottom: 0; height: 68%; border: 3px solid #28452b; border-radius: 42% 42% 22% 22%; background: linear-gradient(90deg, #3e7b45 0 48%, #2e6538 49% 100%); }.beach-player-icon::after { content: \"\"; position: absolute; left: 29%; top: 3%; width: 42%; aspect-ratio: 1; border: 3px solid #4d3020; border-radius: 50%; background: #d7a36d; box-shadow: 0 -6px 0 3px #416d3c; }.beach-rake-tool { position: absolute; z-index: 6; left: 50%; top: -26%; width: 5px; height: 73%; border-radius: 3px; background: #7b4b27; transform-origin: 50% 92%; }.beach-rake-tool::before { content: \"\"; position: absolute; left: -14px; top: -2px; width: 33px; height: 6px; border: 3px solid #3d301d; background: #c5bd8a; box-shadow: -11px 7px 0 -4px #3d301d, 0 7px 0 -4px #3d301d, 11px 7px 0 -4px #3d301d; }.beach-player-icon[data-facing=\"L\"] .beach-rake-tool { transform: rotate(-90deg); }.beach-player-icon[data-facing=\"R\"] .beach-rake-tool { transform: rotate(90deg); }.beach-player-icon[data-facing=\"D\"] .beach-rake-tool { transform: rotate(180deg); }"
