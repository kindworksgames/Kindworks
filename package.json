{
  "name": "kindworks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/generate-phase8b-approved-index.mjs && node scripts/validate-asset-contracts.mjs --scope full && node scripts/audit-asset-contract-stage2.mjs && node scripts/audit-legacy-compatibility.mjs && node scripts/generate-asset-lab-production-index.mjs",
    "predev": "node scripts/generate-phase8b-approved-index.mjs && node scripts/generate-asset-lab-production-index.mjs",
    "dev": "vite",
    "build": "vite build",
    "build:test-metrics": "node scripts/build-test-metrics.mjs",
    "postbuild": "node scripts/verify-performance-budget.mjs && node scripts/verify-production-surface.mjs && node scripts/validate-visual-registry.mjs && node scripts/validate-scene-layouts.mjs && node scripts/verify-production-scene-layouts.mjs && node scripts/validate-scale-system.mjs && node scripts/validate-artwork-pipeline.mjs && node scripts/validate-phase8a-production-package.mjs && node scripts/validate-phase10-production-plan.mjs && node scripts/verify-visual-regression-baselines.mjs",
    "performance:check": "node scripts/verify-performance-budget.mjs",
    "performance:town": "node scripts/measure-production-town.mjs",
    "qa:mobile": "node scripts/audit-mobile-visual-readiness.mjs",
    "parity:differential": "node scripts/verify-differential-parity.mjs",
    "parity:minigames": "node scripts/verify-minigame-parity.mjs",
    "visual:baseline:check": "node scripts/verify-visual-regression-baselines.mjs",
    "visual:capture": "node scripts/visual-comparison.mjs capture",
    "visual:compare": "node scripts/visual-comparison.mjs compare",
    "visual:approve": "node scripts/visual-comparison.mjs approve",
    "visual:reference:check": "node scripts/verify-reference-comparison.mjs",
    "visual:stage6:retest": "node scripts/retest-reference-comparison-stage6.mjs",
    "visual:registry:check": "node scripts/validate-visual-registry.mjs",
    "visual:layout:check": "node scripts/validate-scene-layouts.mjs",
    "visual:scale:check": "node scripts/validate-scale-system.mjs",
    "artwork:generate-packs": "node scripts/generate-artwork-runtime-packs.mjs",
    "artwork:check": "node scripts/validate-artwork-pipeline.mjs",
    "assets:contracts:export": "node scripts/export-asset-contract-catalog.mjs",
    "assets:validate": "node scripts/validate-asset-contracts.mjs --scope full",
    "assets:validate:adversarial": "node scripts/audit-asset-contract-stage2.mjs",
    "assets:validate:changed": "node scripts/validate-asset-contracts.mjs --changed",
    "assets:legacy-audit": "node scripts/audit-legacy-compatibility.mjs",
    "assetlab:generate": "node scripts/generate-phase8b-approved-index.mjs && node scripts/generate-asset-lab-production-index.mjs",
    "assetlab:prepare": "node scripts/prepare-asset-lab-candidate.mjs",
    "assetlab:approve": "node scripts/approve-artwork-candidate.mjs",
    "assetlab:place": "node scripts/set-candidate-layout-offset.mjs",
    "assetlab:reference": "node scripts/set-candidate-reference.mjs",
    "assetlab:verify-replacement": "node scripts/verify-controlled-replacement-runtime.mjs",
    "phase8a:check": "node scripts/validate-phase8a-production-package.mjs",
    "phase8a:export": "node scripts/export-phase8a-production-package.mjs",
    "phase10:check": "node scripts/validate-phase10-production-plan.mjs",
    "assets:powerwash": "node scripts/extract-powerwash-assets.mjs",
    "assets:animals": "node scripts/extract-animal-reference-assets.mjs",
    "preview": "vite preview",
    "test": "node --test"
  },
  "dependencies": {
    "phaser": "^4.2.1"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
